# Copy to .env (git-ignored) and replace every 'changeme': docker compose reads it from this folder.
#   cp .env.example .env
# apply refuses to start while the database password is still 'changeme'.
# Every secret compose.yml uses comes from here; none are written in compose.yml itself.

# ── Postgres (required) ──────────────────────────────────────────────────────
# A long random password, letters and digits only (it goes into a database URL), e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=changeme
POSTGRES_USER=apply
POSTGRES_DB=apply

# ── The model ────────────────────────────────────────────────────────────────
# A local model server on this machine. Easier: choose a model in the app, Settings → Model (it finds the model
# servers running here). Until you do, APPLY_LLM_MODEL is required: the name of a model your server has.
# APPLY_LLM_API=native          # native (/api/chat), or v1 (/v1/chat/completions)
# APPLY_LLM_BASE_URL=http://host.docker.internal:11434
APPLY_LLM_MODEL=
# A second, stronger model just for writing documents (empty: the one above writes too)
# APPLY_LLM_WRITING_MODEL=
# The context window in tokens (bigger needs more memory)
# APPLY_LLM_NUM_CTX=16384

# ── Files (optional: these are the defaults) ─────────────────────────────────
# PDFs, screenshots and uploaded resumes go to an object storage bucket. Compose runs a local storage emulator
# (the storage service). In the cloud, use a real bucket: your provider's storage address, a bucket that exists,
# and the service's own credentials (with read and write access to the bucket).
# APPLY_STORAGE_ENDPOINT=https://storage.googleapis.com
# APPLY_STORAGE_BUCKET=apply
# APPLY_STORAGE_PROJECT=

# ── Email (optional: compose sends it to a local mail catcher, http://127.0.0.1:8035) ─
# "Forgot your password?" emails a link. To send real email, use your email provider's SMTP relay and the web
# app's public address for the link.
# APPLY_PUBLIC_URL=https://apply.example.org
# APPLY_SMTP_HOST=smtp.example.org
# APPLY_SMTP_PORT=587
# APPLY_SMTP_SECURITY=starttls   # or tls (port 465), or none (only for a server on this machine)
# APPLY_SMTP_USERNAME=apikey
# APPLY_SMTP_PASSWORD=
# APPLY_MAIL_FROM=apply <apply@example.org>
